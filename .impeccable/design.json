  "narrative": {
    "northStar": "The Clerk's Desk",
    "overview": "Pleadli looks like a well-kept desk in a registry office: a quiet cool-grey surface, with the work laid on it as white sheets. The papers users produce are the hero, so the chrome stays plain, exact and unhurried. All five apps share this base; only one accent per institution differs.",
    "keyCharacteristics": [
      "Cool-grey page, white lifted sheets, crisp neutral ink",
      "One accent per institution, never two on one screen",
      "Inter throughout; papers switch to serif on their own sheet",
      "12px sheet radius, soft layered shadows, hairline borders",
      "Full-height attached sidebar with a rounded window frame and glass capsules in the toolbar",
      "Light and dark themes with identical structure"
    ],
    "rules": [
      { "name": "The One Accent Rule", "body": "A screen carries its institution's accent on the primary action, focus ring and active nav, and nowhere else.", "section": "colors" },
      { "name": "The Sheet Rule", "body": "What the user works on sits on Sheet White over Page Grey. Never put a white card on white.", "section": "colors" },
      { "name": "The Semantic Type Rule", "body": "Sizes and weights come from tags and slots, never from classes on content.", "section": "typography" },
      { "name": "The Attached Sidebar Rule", "body": "The sidebar is full height and attached. Floating glass is reserved for toolbar capsules.", "section": "elevation" },
      { "name": "The Visible Focus Rule", "body": "Every row, tab and footer control in the shell takes a 2px focus-visible ring; nothing interactive is focusable without one.", "section": "elevation" }
    ],
    "dos": [
      "Do lay content on Sheet White over Page Grey, with the 12px radius and resting shadow.",
      "Do use the institution's accent once per view: primary action, focus, active nav.",
      "Do keep one primary action per view.",
      "Do build every list as a DataTable with a comprehensive set of fields.",
      "Do set type through semantic tags and slots.",
      "Do design for light and dark with the same structure."
    ],
    "donts": [
      "Don't float the sidebar or add glass outside toolbar capsules.",
      "Don't use a second accent colour or gradient text on a screen.",
      "Don't put inline text size or weight on content markup.",
      "Don't use em-dashes in copy.",
      "Don't make it look like a generic SaaS dashboard.",
      "Don't use the legacy cream and amber palette from globals.css."
    ]
  }
}

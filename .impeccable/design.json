      "css": ".ds-side{width:220px;background:oklch(0.982 0.003 255);padding:8px;display:flex;flex-direction:column;gap:1px;font-family:'Inter Variable',Inter,system-ui,sans-serif}.ds-side-group{padding:12px 10px 2px;font:600 11px/24px inherit;color:oklch(0.5 0.018 258 / .8)}.ds-side-row{display:flex;align-items:center;gap:10px;height:30px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:oklch(0.3 0.015 260);font:400 13px inherit;text-align:left;cursor:pointer}.ds-side-row:hover{background:oklch(0.21 0.015 260 / .05)}.ds-side-row[aria-current=page]{background:oklch(0.852 0.199 91.936 / .12);color:oklch(0.21 0.015 260);font-weight:500}.ds-side-ico{width:16px;height:16px;border-radius:4px;background:oklch(0.5 0.018 258 / .5)}.ds-side-row[aria-current=page] .ds-side-ico{background:oklch(0.681 0.162 75.834)}.ds-side-label{flex:1}.ds-side-count{font-size:12px;font-variant-numeric:tabular-nums;color:oklch(0.5 0.018 258)}.ds-overdue{background:oklch(0.577 0.215 27.3);color:#fff;border-radius:9999px;padding:0 6px;line-height:16px;font-weight:600}.ds-side-row:focus-visible{outline:none;box-shadow:0 0 0 2px oklch(0.737 0.021 106.9 / .5)}.ds-side-foot{margin-top:12px;padding:10px 8px;border-top:1px solid oklch(0.915 0.006 255 / .5);font-size:12px;color:oklch(0.5 0.018 258)}"

{
  "name": "lawyers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run i18n && vite build && tsc",
    "check": "bun run i18n && tsc --noEmit",
    "preview": "vite preview",
    "tauri": "NO_AT_BRIDGE=1 GDK_PROGNAME=\"lawyers\" WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure locale-modules --strategy localStorage baseLocale"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@inlang/paraglide-js": "^2.25.4",

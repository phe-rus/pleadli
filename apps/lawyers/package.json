    "motion": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@inlang/plugin-message-format": "^4.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.36",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pleadli Lawyers",
  "version": "0.1.1",
  "identifier": "com.pleadli.lawyers",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3009",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pleadli Lawyers",
        "label": "lawyers",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#fffcf1",
        "shadow": false,
        "center": true,
        "visible": true,
        "focus": true,
        "skipTaskbar": false,
        "windowEffects": {
          "effects": [],
          "radius": 10
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Pleadli Lawyers: the advocate's practice",
    "publisher": "Pleadli"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMEQyREJDRDRBNkY1MDAKUldRQTlhYlV2QzBOKzNOUjRzbllhb2hqcGx5YlYrNDlKSUlKaWJ1TlJHK0JSSlFWMXR4L0I1ZUEK",
      "endpoints": [
        "https://github.com/phe-rus/pleadli-releases/releases/download/lawyers-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

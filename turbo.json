{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"dist/**"
			]
		},
		"check": {
			"outputs": []
		},
		"typecheck": {
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"format": {
			"cache": false
		},
		"deploy": {
			"dependsOn": [
				"build"
			],
			"cache": false
		}
	}
}

# Copy to .env.local and fill in real values. Wrangler and the Cloudflare Vite
# plugin read it for local development. Production secrets are not kept in a
# file: set them with `bunx wrangler secret put <NAME>`.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-real-random-secret"
ORCHESTRA_SIGNING_KEY="replace-with-a-real-signing-key"

{
	"name": "pleadli",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "bun run i18n && vite build",
		"check": "tsc --noEmit",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"auth:gen": "bunx @better-auth/cli generate --config=./src/auth/index.ts --output=./src/db/auth-schema.ts --yes",
		"db:gen": "bunx drizzle-kit generate --config=drizzle.config.ts",
		"db:studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
		"db:local": "bunx wrangler d1 migrations apply pleadli --local",
		"db:remote": "bunx wrangler d1 migrations apply pleadli --remote",
		"local": "bun run db:gen && bun run db:local",
		"remote": "bun run local && bun run db:remote",
		"i18n": "python3 i18n-src/build.py && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@better-auth/drizzle-adapter": "^1.7.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@pleadli/forms-tables": "workspace:*",
		"@pleadli/institution": "workspace:*",
		"@pleadli/templates": "workspace:*",
		"@pleadli/ui": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "^9.2.4",
		"better-auth": "^1.7.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.2.6",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@inlang/paraglide-js": "^2.25.0",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.11",
		"oxc-transform-react": "^0.148.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.129.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}

{
	"name": "pleadli",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"check": "tsc --noEmit",
		"preview": "vite build && vite preview",
		"deploy": "vite build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test:workerd": "bun tests/workerd/run.ts",
		"auth:gen": "bunx auth generate --config ./src/auth/index.ts --output ./src/db/auth-schema.ts --yes",
		"db:gen": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:local": "wrangler d1 migrations apply pleadli-database --local",
		"db:remote": "wrangler d1 migrations apply pleadli-database --remote",
		"local": "bun run db:gen && bun run db:local",
		"remote": "bun run local && bun run db:remote",
		"seed": "bash scripts/seed-dev.sh && bash scripts/seed-demo.sh",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale",
		"i18n:check": "bun scripts/check-messages.ts"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.25",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/react": "^1.1.10",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@pleadli/forms-tables": "workspace:*",
		"@pleadli/institution": "workspace:*",
		"@pleadli/shell": "workspace:*",
		"@pleadli/templates": "workspace:*",
		"@pleadli/ui": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.5",
		"better-auth": "^1.7.25",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^1.0.0-rc.5",
		"motion": "^14.14.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.70.0",
		"@inlang/paraglide-js": "^2.25.0",
		"@tanstack/devtools-vite": "^0.8.6",
		"@tanstack/react-devtools": "^0.10.14",
		"@tanstack/react-router-devtools": "^1.167.3",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.3.0",
		"auth": "^1.7.25",
		"drizzle-kit": "^1.0.0-rc.5",
		"oxc-transform-react": ">=0.152.0 <0.157.0",
		"typescript": "^6.0.2",
		"vite": "^8.3.8",
		"wrangler": "^4.164.0"
	}
}
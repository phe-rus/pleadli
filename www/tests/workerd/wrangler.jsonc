{
	// A throwaway Worker that hosts the REAL QuotaCounter class in the local Cloudflare runtime (workerd).
	// Used only by tests/workerd/run.ts. It is never deployed and touches no Cloudflare account.
	"name": "pleadli-quota-test",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./worker.ts",
	"durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
	"migrations": [{ "tag": "quota-v1", "new_sqlite_classes": ["QuotaCounter"] }]
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pleadli",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": false
	},
     "placement": {
        "mode": "smart"
    },
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "custom_domain": true,
            "pattern": "pleadli.com"
        }
    ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pleadli",
			"database_id": "5e867f96-73d0-4c44-ad39-e80aaf99a4fa",
			"migrations_dir": ".migrations",
			"migrations_pattern": "./.migrations/*/migration.sql"
		}
	]
}
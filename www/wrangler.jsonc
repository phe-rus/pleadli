{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pleadli",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/server.ts",
	"observability": {
		"enabled": false
	},
	"placement": {
		"mode": "smart"
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "pleadli.com"
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	},
	"r2_buckets": [
		{
			"binding": "POSTBOX",
			"bucket_name": "pleadli-post"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pleadli-database",
			"database_id": "09f65704-c904-4718-84a9-cf5e613acc47",
			"migrations_dir": ".migrations",
			"migrations_pattern": ".migrations/*/migration.sql"
		}
	]
}
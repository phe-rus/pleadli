{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pleadli",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/server.ts",
	"observability": {
		"enabled": false
	},
     "placement": {
        "mode": "smart"
    },
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "custom_domain": true,
            "pattern": "pleadli.com"
        }
    ],
	"r2_buckets": [
		{
			"binding": "RELAY",
			"bucket_name": "pleadli-relay"
		}
	],
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pleadli",
			"database_id": "5e867f96-73d0-4c44-ad39-e80aaf99a4fa",
			"migrations_dir": ".migrations",
			"migrations_pattern": ".migrations/*/migration.sql"
		}
	]
}